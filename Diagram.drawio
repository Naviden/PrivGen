          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SegDKhn3ESl1ZfdKmo15-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Hyper-Parameter Optimization&lt;/font&gt;&lt;/h1&gt;&lt;p style=&quot;margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 14px; line-height: normal; color: rgb(14, 14, 14);&quot; class=&quot;p1&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;The expert provides her estimation of the proportion of outlier records. Param Finder applies a wide range of hyperparameters and ranks the results based on their similarity to the expert’s expectations.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="SegDKhn3ESl1ZfdKmo15-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;Outlier Detection by Clustering&lt;/span&gt;&lt;/h1&gt;&lt;p style=&quot;margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 14px; line-height: normal; color: rgb(14, 14, 14);&quot; class=&quot;p1&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;The expert selects a set of parameters, which are then used by the DBSCAN algorithm to identify and remove outliers.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="SegDKhn3ESl1ZfdKmo15-7" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;Calculation of Weighted Distances&lt;/span&gt;&lt;/h1&gt;&lt;p style=&quot;margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 14px; line-height: normal; color: rgb(14, 14, 14);&quot; class=&quot;p1&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Using the feature weights provided by the expert, the weighted Euclidean distance of each record from its corresponding cluster’s geometric median is calculated.&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="395" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8Ty9u0OfBwFfZ0FzzogC-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 17px;&quot;&gt;Outlier Detection by Distance&lt;/span&gt;&lt;/h1&gt;&lt;p style=&quot;margin: 0px; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-stretch: normal; font-size: 14px; line-height: normal; color: rgb(14, 14, 14);&quot; class=&quot;p1&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;For each cluster, the expert sets a cutting threshold. This threshold is then used to eliminate records that exceed it&lt;/font&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="525" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8Ty9u0OfBwFfZ0FzzogC-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3333333333333333;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="MUi7LtVfqCFP66UB170B-25" target="MUi7LtVfqCFP66UB170B-37">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="230" as="sourcePoint" />
            <mxPoint x="100" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="8Ty9u0OfBwFfZ0FzzogC-4" value="Distributions" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="8Ty9u0OfBwFfZ0FzzogC-3">
